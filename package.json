{
  "name": "electron-blocks",
  "version": "0.0.1",
  "description": "Timeblocks desktop shell — loads the react-web-calendar build in the main process",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc",
    "tc": "tsc --noEmit",
    "start": "npm run build && electron .",
    "start:dev": "npm run build && WEB_DEV_SERVER=http://localhost:3000 electron .",
    "sync:web": "rm -rf web-build && cp -R ../react-web-calendar/build web-build",
    "dist": "npm run build && npm run sync:web && electron-builder",
    "dist:mac": "npm run build && npm run sync:web && electron-builder --mac",
    "dist:win": "npm run build && npm run sync:web && electron-builder --win"
  },
  "build": {
    "appId": "com.timeblocks.blocks",
    "productName": "Timeblocks Blocks",
    "files": [
      "main.js",
      "preload.js",
      "push.js",
      "assets/**/*",
      "web-build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "zip"
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@eneris/push-receiver": "^4.3.1",
    "firebase-admin": "^13.10.0"
  }
}
